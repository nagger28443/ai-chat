# ============================================
# AI Chat Demo - 环境变量配置
# ============================================
# 复制本文件为 .env，按需修改配置值。
# 未设置的变量使用代码中的默认值。

# ============ 后端 (Backend) ============

# 服务端口（默认 3000）
PORT=3000

# AI 服务提供者（当前支持 mock；未来支持 openai / claude）
AI_PROVIDER=mock

# 限流配置
# 窗口时长（毫秒，默认 15000 = 15 秒）
RATE_LIMIT_WINDOW_MS=15000
# 每窗口最大请求数（默认 100）
RATE_LIMIT_MAX=100

# 请求体大小限制（默认 1mb）
BODY_JSON_LIMIT=1mb

# 优雅停机超时（毫秒，默认 10000）
SHUTDOWN_TIMEOUT_MS=10000

# Mock AI 配置
# 每个字符生成延迟（毫秒，默认 20）
CHAR_GENERATION_DELAY_MS=20
# 缓存清理延迟（毫秒，默认 5000）
CACHE_CLEANUP_DELAY_MS=5000

# ============ 前端 (Frontend) ============

# 开发服务器端口（默认 5173）
# VITE_PORT=5173

# 后端 API 地址（默认 /api，通过 Vite 代理转发）
# VITE_API_BASE_URL=/api
