{
  "name": "backend",
  "version": "1.0.0",
  "description": "AI Chat Demo Backend",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "dev:watch": "nodemon",
    "debug": "nodemon --exec \"tsx --inspect src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src --ext ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@trpc/server": "^11.18.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
